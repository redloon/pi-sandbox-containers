#!/usr/bin/env bash
# install — one-time setup for pi-sandbox-containers. Idempotent: safe to re-run.
#
#   ./install              install pis, seed .env, run checks, build images
#   ./install --no-build   skip image builds (pis auto-builds on first use anyway)
#   ./install --no-auth-seed   don't touch .env
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$HOME/.config/pi-sandbox"
CONFIG_FILE="$CONFIG_DIR/config"
BIN_DIR="$HOME/.local/bin"

NO_BUILD=0 NO_AUTH=0
for a in "$@"; do
  case "$a" in
    --no-build) NO_BUILD=1 ;;
    --no-auth-seed) NO_AUTH=1 ;;
    *)
      echo "install: unknown option $a" >&2
      exit 1
      ;;
  esac
done

# --- 1. launcher (symlinked: repo edits to bin/pis are live immediately) ------
echo "• linking pis → $BIN_DIR/pis (symlink to $HERE/bin/pis)"
mkdir -p "$BIN_DIR" "$CONFIG_DIR"
ln -sfn "$HERE/bin/pis" "$BIN_DIR/pis"

# --- 2. config (preserve a previously chosen PI_VERSION) ---------------------
PI_VERSION="${PI_VERSION:-1.2.0}"
if [[ -f "$CONFIG_FILE" ]]; then
  old="$(sed -nE 's/^PI_VERSION="?([^"]+)"?$/\1/p' "$CONFIG_FILE" | head -1)"
  if [[ -n "$old" ]]; then PI_VERSION="$old"; fi
fi
cat >"$CONFIG_FILE" <<EOF
# pi-sandbox config (written by ./install; PI_SANDBOX_HOME is this checkout)
PI_SANDBOX_HOME="$HERE"
PI_VERSION="$PI_VERSION"
EOF
echo "• config → $CONFIG_FILE (PI_VERSION=$PI_VERSION)"

# --- 3. PATH -----------------------------------------------------------------
if ! grep -qs '\.local/bin' "$HOME/.bashrc"; then
  # shellcheck disable=SC2016  # literal $HOME/$PATH must land in .bashrc unexpanded.
  printf '\n# pis (pi-sandbox-containers)\nexport PATH="$HOME/.local/bin:$PATH"\n' >>"$HOME/.bashrc"
  echo "• added ~/.local/bin to PATH in ~/.bashrc (open a new shell or: source ~/.bashrc)"
fi

# --- 4. seed .env with provider credentials (values are never printed) -------
# The passthrough contract: every variable in .env becomes process env inside
# every sandbox, so any provider pi supports works with zero code changes.
# auth.json entries with a .key seed <SLUG_UPPER_WITH_UNDERSCORES>_API_KEY;
# entries without one (OAuth /login) get a loud note — sandboxes are env-only.
if [[ $NO_AUTH == 0 && ! -f "$HERE/.env" ]]; then
  auth_json="$HOME/.pi/agent/auth.json"
  seeded="" keyless=""
  if [[ -f "$auth_json" ]] && command -v jq >/dev/null 2>&1; then
    umask 077
    : >"$HERE/.env"
    while IFS=$'\t' read -r slug key; do
      [[ -n "$slug" && -n "$key" ]] || continue
      name="$(printf '%s' "$slug" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9]\+/_/g')_API_KEY"
      printf '%s=%s\n' "$name" "$key" >>"$HERE/.env"
      seeded="${seeded:+$seeded, }$name"
    done < <(jq -r 'to_entries[] | select((.value | type) == "object")
      | select((.value.key? // "") != "")
      | [.key, (.value.key | tostring)] | @tsv' "$auth_json" 2>/dev/null || true)
    while IFS= read -r slug; do
      [[ -n "$slug" ]] || continue
      name="$(printf '%s' "$slug" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9]\+/_/g')_API_KEY"
      keyless="${keyless:+$keyless, }$slug → $name"
    done < <(jq -r 'to_entries[] | select((.value | type) == "object")
      | select((.value.key? // "") == "") | .key' "$auth_json" 2>/dev/null || true)
  fi
  if [[ -n "$seeded" ]]; then
    echo "• auth: seeded .env from $auth_json (gitignored; values never printed): $seeded"
  else
    rm -f "$HERE/.env"
    echo "• auth: nothing seeded — copy .env.example to .env and set your provider's key(s)"
    echo "        (every var in .env is injected into sandboxes; exported *_API_KEY host vars work too)"
  fi
  if [[ -n "$keyless" ]]; then
    echo "• auth: auth.json entries without an API key (OAuth /login?): $keyless"
    echo "        sandboxes are env-only (no auth.json on disk) — if pi's provider docs name an"
    echo "        env var, add it to .env by hand (the <name>_API_KEY convention can differ)."
  fi
fi

# --- 5. dev tooling (test gate tools; optional and non-fatal) -----------------
if command -v mise >/dev/null 2>&1; then
  echo "• dev tools: mise install (shellcheck/shfmt/bats pins for scripts/check.sh)"
  if ! (cd "$HERE" && mise install); then
    echo "• dev tools: mise install failed — non-fatal (scripts/check.sh uses system shellcheck/shfmt/bats first)" >&2
  fi
else
  echo "• dev tools: mise not found — fine, scripts/check.sh prefers system shellcheck/shfmt/bats"
fi

# --- 6. checks ---------------------------------------------------------------
echo "• environment checks (pis doctor):"
if ! "$BIN_DIR/pis" doctor; then
  echo "• doctor reported issues above — fix them, then re-run ./install" >&2
fi

# --- 7. images ---------------------------------------------------------------
if [[ $NO_BUILD == 0 ]]; then
  echo "• building sandbox images (first build takes several minutes)…"
  "$BIN_DIR/pis" rebuild all
fi

echo
echo "Done. The everyday command is:  pis"
echo "  cd ~/work/my-app && pis       # your repo's sandbox, straight into pi"
echo "  pis -p \"your task\"                # unattended one-shot"
echo "  pis doctor                        # re-run checks any time"
