#!/usr/bin/env bash
# pis — run pi inside a Docker sandbox (pi-sandbox-containers).
#
# The everyday command: from any work repo, `pis` finds the repo root, picks the
# right sandbox profile, builds the image if missing/stale, starts or reuses the
# keep-alive container, and runs pi inside it — exactly like local `pi`, with all
# arguments passed through. If any part of the chain fails, pis hard-errors and
# NEVER falls back to host pi: whenever pis runs pi, the boundary is real.
set -euo pipefail

PIS_VERSION="1.0.0"

# ---------------------------------------------------------------- utilities --
die() {
  printf 'pis: error: %s\n' "$1" >&2
  if [[ $# -gt 1 ]]; then printf '      hint: %s\n' "$2" >&2; fi
  exit 1
}
note() { printf '⬢ %s\n' "$*" >&2; }
warn() { printf '! %s\n' "$*" >&2; }

usage() {
  cat <<'EOF'
pis — run pi inside a Docker sandbox (pi-sandbox-containers)

Usage:
  pis [pi args…]            run pi in this repo's sandbox (e.g. pis -p "task")
  pis -- [pi args…]         force passthrough (e.g. pis -- shell as a prompt)
  pis run -- <cmd> [args]   run any command in the sandbox (exit code preserved)
  pis shell                 interactive shell in the sandbox
  pis logs [-f]             container logs (entrypoint/startup output)
  pis status                repo, profile, image and container state
  pis doctor [--smoke]      environment checks (+ smoke-test pi auth)
  pis rebuild [general|web|android|all]   force image rebuild (default: profile)
  pis use-pi [x.y.z]        pin the sandbox pi (default: host pi's) + rebuild
  pis down                  stop this repo's sandbox container
  pis clean -y              stop and DELETE this sandbox's volumes (sessions too)
  pis install-apk [path] [args…]  adb-install an APK onto a PHYSICAL device from
                            the host (default: newest */build/outputs/*.apk)
  pis sync-config [--with-agents] [--keep-pi-sbx] [--no-npm]
                            force a pi-home/ refresh from ~/.pi/agent now
                            (also automatic before every pi/run/shell;
                            disable with PI_SANDBOX_NO_SYNC=1)
  pis --host [pi args…]     explicitly run the UNSANDBOXED host pi

Profiles are auto-detected from the repo (android > web > general). Override
with PI_SANDBOX_PROFILE=… or a .pi-sandbox.toml in the repo root:
    profile = "android"   # or "web" / "general"
Android toolchain knobs (env overrides the file; defaults shown):
    sdk_components = "platforms/android-36 build-tools/36.0.0 system-images/android-34/google_apis/x86_64"
    avd_name       = "pixel_6_api_34"
    system_image   = "system-images;android-34;google_apis;x86_64"
  env names: PI_SANDBOX_ANDROID_SDK_COMPONENTS / PI_SANDBOX_AVD_NAME /
             PI_SANDBOX_ANDROID_SYSTEM_IMAGE

Provider auth is a passthrough contract: every variable in .env is injected
into every sandbox; host *_API_KEY vars (plus PI_SANDBOX_EXTRA_ENV names) are
passed per exec. Keyless providers: PI_SANDBOX_ALLOW_NO_AUTH=1.
EOF
}

# ------------------------------------------------- resolve pi-sandbox-containers --
_script="${BASH_SOURCE[0]}"
while [[ -L "$_script" ]]; do _script="$(readlink "$_script")"; done
_script_dir="$(cd "$(dirname "$_script")" && pwd)"

# Environment wins over the config file (12-factor precedence; also lets the
# tests in tests/ point the tool at throwaway trees).
_PI_SANDBOX_HOME_ENV="${PI_SANDBOX_HOME:-}"
CONFIG_FILE="${PI_SANDBOX_CONFIG:-$HOME/.config/pi-sandbox/config}"
if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$CONFIG_FILE"
fi
if [[ -n "$_PI_SANDBOX_HOME_ENV" ]]; then
  PI_SANDBOX_HOME="$_PI_SANDBOX_HOME_ENV"
fi
if [[ -z "${PI_SANDBOX_HOME:-}" ]]; then
  if [[ -f "$_script_dir/../compose.yaml" ]]; then
    PI_SANDBOX_HOME="$(cd "$_script_dir/.." && pwd)"
  else
    die "PI_SANDBOX_HOME is not set and $CONFIG_FILE does not exist" \
      "run ./install from pi-sandbox-containers first"
  fi
fi
PI_VERSION="${PI_VERSION:-1.2.0}"

# Image content stamp: anything under docker/ or a PI_VERSION bump marks images stale.
# Failure-proof: config-only commands must work against a bare PI_SANDBOX_HOME.
# Recomputed by `pis use-pi` when the pin changes mid-run.
compute_docker_hash() {
  { (cd "$PI_SANDBOX_HOME" 2>/dev/null && find docker -type f -print0 2>/dev/null | LC_ALL=C sort -z | xargs -0 -r sha256sum || true) && printf 'pi-%s\n' "$PI_VERSION"; } |
    sha256sum | cut -d' ' -f1
}
DOCKER_HASH="$(compute_docker_hash)"
KVM_GID="$(stat -c '%g' /dev/kvm 2>/dev/null || echo 0)"

# ----------------------------------------------------------------- compose -- #
# Generic scalar lookup in the repo's .pi-sandbox.toml (quoted or bare value),
# for keys like profile / sdk_components / avd_name / system_image.
toml_scalar() {
  local key="$1" file="$REPO_ROOT/.pi-sandbox.toml" v=""
  [[ -f "$file" ]] || return 0
  v="$(sed -nE "s|^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\"([^\"]*)\".*|\1|p" "$file" | head -1)"
  if [[ -z "$v" ]]; then
    v="$(sed -nE "s|^[[:space:]]*${key}[[:space:]]*=[[:space:]]*([^\"#]*[^\"#[:space:]])[[:space:]]*(#.*)?$|\1|p" "$file" | head -1)"
  fi
  printf '%s' "$v"
}

# Resolve a config scalar with the standard precedence: env > toml > default.
resolve_config() { # $1=env var name, $2=toml key, $3=default → stdout
  local v="${!1:-}"
  [[ -n "$v" ]] || v="$(toml_scalar "$2")"
  printf '%s' "${v:-$3}"
}

REPO_ROOT=""
PROFILE=""
PROFILE_SOURCE=""
COMPOSE_PROJECT_NAME=""

resolve_context() {
  local dir="$PWD"
  while [[ "$dir" != "/" && ! -d "$dir/.git" && ! -f "$dir/.git" ]]; do dir="$(dirname "$dir")"; done
  if [[ -d "$dir/.git" || -f "$dir/.git" ]]; then REPO_ROOT="$dir"; else REPO_ROOT="$PWD"; fi

  PROFILE="${PI_SANDBOX_PROFILE:-}"
  if [[ -n "$PROFILE" ]]; then
    PROFILE_SOURCE="PI_SANDBOX_PROFILE"
  elif [[ -n "$(toml_scalar profile)" ]]; then
    PROFILE="$(toml_scalar profile)"
    PROFILE_SOURCE=".pi-sandbox.toml"
  elif grep -qE '^[[:space:]]*profile[[:space:]]*[:=]' "$REPO_ROOT/.pi-sandbox.toml" 2>/dev/null; then
    die ".pi-sandbox.toml has a profile line that could not be parsed" \
      'use: profile = "android"   # or "web" / "general"'
  fi
  if [[ -z "$PROFILE" ]]; then
    if [[ -f "$REPO_ROOT/settings.gradle.kts" || -f "$REPO_ROOT/settings.gradle" ||
      -f "$REPO_ROOT/build.gradle.kts" || -f "$REPO_ROOT/build.gradle" ]]; then
      PROFILE=android
    elif [[ -f "$REPO_ROOT/package.json" ]]; then
      PROFILE=web
    else
      PROFILE=general
    fi
    PROFILE_SOURCE="auto-detect"
  fi
  case "$PROFILE" in
    general | web | android) ;;
    *) die "unknown profile '$PROFILE' (expected: general | web | android)" ;;
  esac

  # Android toolchain knobs (env > .pi-sandbox.toml > default): the
  # project-specific SDK components checked on the host, and the AVD/system
  # image the entrypoint prepares (docker/entrypoint.sh).
  ANDROID_SDK_COMPONENTS="$(resolve_config PI_SANDBOX_ANDROID_SDK_COMPONENTS sdk_components "$DEFAULT_SDK_COMPONENTS")"
  ANDROID_AVD_NAME="$(resolve_config PI_SANDBOX_AVD_NAME avd_name pixel_6_api_34)"
  ANDROID_SYSTEM_IMAGE="$(resolve_config PI_SANDBOX_ANDROID_SYSTEM_IMAGE system_image 'system-images;android-34;google_apis;x86_64')"
  collect_exec_env

  local slug h6
  slug="$(basename "$REPO_ROOT" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]\+/-/g; s/^-//; s/-$//')"
  [[ -n "$slug" ]] || slug=repo
  h6="$(printf '%s' "$REPO_ROOT" | sha256sum | cut -c1-6)"
  COMPOSE_PROJECT_NAME="pi-sbx-$slug-$h6"
}

compose() {
  (cd "$PI_SANDBOX_HOME" &&
    COMPOSE_PROJECT_NAME="$COMPOSE_PROJECT_NAME" \
      SANDBOX_WORKDIR="$REPO_ROOT" \
      KVM_GID="$KVM_GID" \
      HOST_UID="$(id -u)" \
      HOST_GID="$(id -g)" \
      PI_VERSION="$PI_VERSION" \
      DOCKER_HASH="$DOCKER_HASH" \
      PI_SANDBOX_ANDROID_SDK="${PI_SANDBOX_ANDROID_SDK:-$HOME/Android/Sdk}" \
      PI_SANDBOX_GIT_HOME="${PI_SANDBOX_GIT_HOME:-$HOME}" \
      PI_SANDBOX_AVD_NAME="${ANDROID_AVD_NAME:-pixel_6_api_34}" \
      PI_SANDBOX_ANDROID_SYSTEM_IMAGE="${ANDROID_SYSTEM_IMAGE:-system-images;android-34;google_apis;x86_64}" \
      docker compose "$@")
}

need_docker() {
  [[ -f "$PI_SANDBOX_HOME/compose.yaml" ]] ||
    die "no compose.yaml under PI_SANDBOX_HOME=$PI_SANDBOX_HOME" \
      "docker commands need the fleet layout (config-only commands like sync-config do not)"
  command -v docker >/dev/null 2>&1 ||
    die "docker is not installed" "install Docker Engine — pis never runs pi unsandboxed"
  docker info >/dev/null 2>&1 ||
    die "the Docker daemon is not reachable" \
      "start it (e.g. sudo systemctl start docker) and retry — pis never runs pi unsandboxed"
  docker compose version >/dev/null 2>&1 ||
    die "docker compose v2 is missing" "install the docker-compose-plugin package"
}

# The .env passthrough uses compose's long-form env_file (required: false),
# which needs Docker Compose >= 2.24. Unknown/odd versions don't block.
compose_version_ok() {
  local v major minor rest
  v="$(docker compose version --short 2>/dev/null | sed 's/^[vV]//')"
  major="${v%%.*}"
  rest="${v#*.}"
  minor="${rest%%.*}"
  [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || return 0
  ((major > 2 || (major == 2 && minor >= 24)))
}

# ------------------------------------------------------------ provider auth --
# The .env passthrough contract: every variable in .env is injected into every
# sandbox (compose env_file), unfiltered — any provider pi supports works with
# zero code changes. Host-environment credentials are forwarded per exec
# (compose exec -e NAME, value read from pis's own env — never in argv) so the
# keep-alive container itself never holds host-env creds. Names are collected
# without values; nothing here ever prints or stores a credential.

# Non-empty credential vars in .env: any name except PI_SANDBOX_* config vars.
dotenv_cred_names() {
  [[ -f "$PI_SANDBOX_HOME/.env" ]] || return 0
  local line name val trimmed
  while IFS= read -r line || [[ -n "$line" ]]; do
    trimmed="${line#"${line%%[![:space:]]*}"}"
    case "$trimmed" in
      '' | '#'*) continue ;;
    esac
    [[ "$line" == *=* ]] || continue
    name="${line%%=*}"
    val="${line#*=}"
    name="${name//[[:space:]]/}"
    case "$name" in
      PI_SANDBOX_*) continue ;;
    esac
    [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    val="${val#\"}"
    val="${val%\"}"
    val="${val#\'}"
    val="${val%\'}"
    [[ -n "${val//[[:space:]]/}" ]] || continue
    printf '%s\n' "$name"
  done <"$PI_SANDBOX_HOME/.env"
  return 0
}

# Host-env credentials forwarded to sandbox execs: every exported *_API_KEY
# plus any names listed in PI_SANDBOX_EXTRA_ENV (comma/space separated).
host_cred_names() {
  local name seen=$'\n' extra
  local -a extra_names=()
  while IFS= read -r name; do
    [[ "$name" == *_API_KEY ]] || continue
    [[ -n "${!name:-}" ]] || continue
    [[ "$seen" == *$'\n'"$name"$'\n'* ]] && continue
    seen+="$name"$'\n'
    printf '%s\n' "$name"
  done < <(compgen -e)
  extra="${PI_SANDBOX_EXTRA_ENV:-}"
  read -r -a extra_names <<<"${extra//,/ }"
  for name in "${extra_names[@]}"; do
    [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    [[ -n "${!name:-}" ]] || continue
    [[ "$seen" == *$'\n'"$name"$'\n'* ]] && continue
    seen+="$name"$'\n'
    printf '%s\n' "$name"
  done
  return 0
}

# Auth is "configured" when ≥1 credential var is visible from .env or the host
# env; PI_SANDBOX_ALLOW_NO_AUTH=1 is the escape hatch for keyless providers.
auth_missing() {
  if [[ "${PI_SANDBOX_ALLOW_NO_AUTH:-0}" == 1 ]]; then return 1; fi
  local names
  names="$(
    dotenv_cred_names
    host_cred_names
  )"
  [[ -z "$names" ]]
}

require_auth() {
  if auth_missing; then
    die "no provider credentials configured" \
      "every var in $PI_SANDBOX_HOME/.env is injected into sandboxes — add your provider's key there (see .env.example), export a *_API_KEY on the host, or run ./install (seeds from ~/.pi/agent/auth.json); keyless providers: PI_SANDBOX_ALLOW_NO_AUTH=1"
  fi
}

# Var NAMES and their sources (with count) — never values; safe to print.
auth_display() {
  local dn hn src="" n
  dn="$(dotenv_cred_names | sort -u)"
  hn="$(host_cred_names | sort -u)"
  if [[ -n "$dn" ]]; then
    src=".env: ${dn//$'\n'/, }"
  fi
  if [[ -n "$hn" ]]; then
    src="${src:+$src; }host env: ${hn//$'\n'/, }"
  fi
  n="$(printf '%s\n%s\n' "$dn" "$hn" | sort -u | grep -c . || true)"
  printf '%s var%s (%s)' "$n" "$([[ "$n" == 1 ]] || printf 's')" "$src"
}

# Host-env credentials reach sandboxes as `compose exec -e NAME`: the value is
# resolved from pis's own environment by the compose CLI, never placed in argv
# (where any process could read it from /proc) and never written to disk.
EXEC_ENV_ARGS=()
collect_exec_env() {
  EXEC_ENV_ARGS=()
  local name
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    EXEC_ENV_ARGS+=(-e "$name")
  done < <(host_cred_names)
  return 0
}

# Version probe only (metadata) — this is not "running pi as a fallback"; the
# never-fall-back-to-host-pi rule is about executing pi instead of the sandbox.
host_pi_version() {
  command -v pi >/dev/null 2>&1 || return 0
  pi --version 2>/dev/null | sed -n 's/^[^0-9]*\([0-9][0-9.]*\).*/\1/p' | head -1
}

# Surface version drift early (README: Updating pi): the sandbox pi is pinned
# and baked into the images while the host pi updates independently.
warn_on_pi_drift() {
  local hostpi
  hostpi="$(host_pi_version)"
  if [[ -n "$hostpi" && "$hostpi" != "$PI_VERSION" ]]; then
    warn "pi version drift: host pi $hostpi, sandbox pinned to $PI_VERSION — run 'pis use-pi' to sync (README: Updating pi)"
  fi
}

ensure_kvm() {
  if [[ "$PROFILE" != android ]]; then return 0; fi
  [[ -c /dev/kvm ]] ||
    die "/dev/kvm does not exist — the android sandbox needs hardware virtualization" \
      "enable VT-x/AMD-V in firmware and load the kvm module"
  if [[ ! -r /dev/kvm || ! -w /dev/kvm ]]; then
    die "no read/write access to /dev/kvm" \
      "sudo usermod -aG kvm \$USER (re-login), or: sudo setfacl -m u:\$USER:rw /dev/kvm"
  fi
}

# The android sandbox bind-mounts the host Android SDK read-only at
# /opt/android-sdk (see compose.yaml): the image carries only JDK 21 and the
# emulator's runtime libs. Refuse to start with a missing or partial SDK — the
# failure would otherwise surface much later inside Gradle/emulator, far from
# the cause.
# Structural SDK parts: the tooling `pis` and the emulator themselves need —
# always required, not configurable.
ANDROID_SDK_STRUCTURAL=(
  "cmdline-tools/latest"
  "platform-tools"
  "emulator"
)
# Project-specific parts (compile SDK, build tools, system image): configurable
# via PI_SANDBOX_ANDROID_SDK_COMPONENTS or sdk_components in .pi-sandbox.toml
# (space-separated; dir or sdkmanager ';' form). Defaults are the current pin.
DEFAULT_SDK_COMPONENTS="platforms/android-36 build-tools/36.0.0 system-images/android-34/google_apis/x86_64"
ANDROID_SDK_COMPONENTS="$DEFAULT_SDK_COMPONENTS"
ANDROID_AVD_NAME="pixel_6_api_34"
ANDROID_SYSTEM_IMAGE="system-images;android-34;google_apis;x86_64"

android_sdk_root() { printf '%s' "${PI_SANDBOX_ANDROID_SDK:-$HOME/Android/Sdk}"; }

# Print the required components missing under the SDK root (the root itself when
# the directory is absent); empty output means the SDK is complete.
android_sdk_missing_parts() {
  local root="$1" p
  local -a extra=()
  read -r -a extra <<<"$ANDROID_SDK_COMPONENTS"
  if [[ ! -d "$root" ]]; then
    printf '%s\n' "$root"
    return 0
  fi
  for p in "${ANDROID_SDK_STRUCTURAL[@]}" "${extra[@]}"; do
    p="${p//;//}"
    [[ -d "$root/$p" ]] || printf '%s\n' "$p"
  done
}

# sdkmanager-shaped hint (that CLI uses ';' separators): everything the host
# SDK must carry, derived from the configured components.
sdkmanager_hint() {
  local p out=""
  local -a extra=()
  read -r -a extra <<<"$ANDROID_SDK_COMPONENTS"
  for p in platform-tools emulator "${extra[@]}"; do
    out="${out:+$out }\"${p//\//;}\""
  done
  printf '%s' "$out"
}

# Comma-joined missing parts for humans (pure bash: this runs under the test
# suite's restricted PATH too).
android_sdk_missing_csv() {
  local p csv=""
  while IFS= read -r p; do
    [[ -n "$p" ]] && csv="${csv:+$csv, }$p"
  done < <(android_sdk_missing_parts "$1")
  printf '%s' "$csv"
}

ensure_android_sdk() {
  [[ "$PROFILE" == android ]] || return 0
  local root missing
  root="$(android_sdk_root)"
  missing="$(android_sdk_missing_csv "$root")"
  if [[ ! -d "$root" ]]; then
    die "the android sandbox needs a host Android SDK at $root — the directory does not exist" \
      "provision one (Android Studio's SDK Manager, or: sdkmanager $(sdkmanager_hint)) or set PI_SANDBOX_ANDROID_SDK=/path/to/Android/Sdk"
  fi
  [[ -z "$missing" ]] ||
    die "the host Android SDK at $root is incomplete — missing: $missing" \
      "install the missing components (sdkmanager $(sdkmanager_hint)) or set PI_SANDBOX_ANDROID_SDK=/path/to/Android/Sdk"
}

ensure_image() {
  local p="$1" have
  if [[ "$p" != general ]]; then
    # web/android are layered images: pi-sandbox:general must exist first.
    ensure_image general
  fi
  have="$(docker image inspect "pi-sandbox:$p" --format '{{index .Config.Labels "org.pi-sandbox.dockerhash"}}' 2>/dev/null || true)"
  if [[ "$have" != "$DOCKER_HASH" ]]; then
    note "building pi-sandbox:$p (first run, or docker/ changed since last build)…"
    compose build "$p" || die "building pi-sandbox:$p failed" "see output above; try: pis rebuild $p"
  fi
}

# The host git identity/config is bind-mounted read-only into every sandbox so
# commits inside carry the host identity (README: Git in the sandbox). Prepare
# the mount sources as empty file/dir when missing — Docker would otherwise
# create root-owned directories in their place.
ensure_git_home() {
  local gh="${PI_SANDBOX_GIT_HOME:-$HOME}"
  [[ -e "$gh/.gitconfig" ]] || touch "$gh/.gitconfig"
  mkdir -p "$gh/.config/git"
}

ensure_container() {
  local out
  ensure_git_home
  if ! out="$(compose up -d "$PROFILE" 2>&1)"; then
    printf '%s\n' "$out" >&2
    die "failed to start the $PROFILE sandbox container"
  fi
  # compose up -d returns as soon as the container runs, while the entrypoint is
  # still seeding config and preparing the sandbox (e.g. the android AVD).
  # Wait for its ready marker or an immediate exec races that work.
  local i
  for ((i = 0; i < 120; i++)); do
    if compose exec -T "$PROFILE" test -e /tmp/pi-sandbox-ready >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.5
  done
  die "the $PROFILE sandbox container did not become ready within 60s" \
    "check startup output: pis logs"
}

# Pi runs with all tools and zero permission prompts (the container IS the
# boundary). Interactive runs drop into a sandbox shell after pi exits/crashes.
# seed-pi-home failures are fatal: a half-seeded agent dir is exactly the class
# of state drift that produces mysterious startup errors (see tests/, run via
# scripts/check.sh).
# shellcheck disable=SC2016  # $@ / $? are expanded inside the container, not here.
WRAPPER_SEED='seed-pi-home || { echo "pi-sandbox: config seed failed — see above (pis clean -y resets the volume)" >&2; exit 1; }'
# shellcheck disable=SC2016  # $@ / $? are expanded inside the container, not here.
WRAPPER_INTERACTIVE="$WRAPPER_SEED"'; pi "$@"; rc=$?; echo; echo "pi exited $rc — sandbox shell (exit to leave)"; echo "hint: seed-pi-home re-syncs config from pi-home/; pi -ne starts without extensions"; exec bash'
WRAPPER_PLAIN="$WRAPPER_SEED"'; exec pi "$@"'

run_pi() {
  printf '⬢ %s sandbox · %s\n' "$PROFILE" "$REPO_ROOT" >&2
  if [[ -t 0 && -t 1 ]]; then
    compose exec ${EXEC_ENV_ARGS[@]+"${EXEC_ENV_ARGS[@]}"} "$PROFILE" bash -lc "$WRAPPER_INTERACTIVE" pis-sh "$@"
  else
    compose exec -T ${EXEC_ENV_ARGS[@]+"${EXEC_ENV_ARGS[@]}"} "$PROFILE" bash -lc "$WRAPPER_PLAIN" pis-sh "$@"
  fi
}

# ------------------------------------------------------------- subcommands -- #
cmd_pi() {
  resolve_context
  auto_sync
  need_docker
  require_auth
  warn_on_pi_drift
  ensure_android_sdk
  ensure_kvm
  ensure_image "$PROFILE"
  ensure_container
  run_pi "$@"
}

cmd_run() {
  if [[ "${1:-}" == "--" ]]; then shift; fi
  [[ $# -gt 0 ]] || die "usage: pis run -- <command> [args…]"
  resolve_context
  auto_sync
  need_docker
  ensure_android_sdk
  ensure_kvm
  ensure_image "$PROFILE"
  ensure_container
  compose exec -T ${EXEC_ENV_ARGS[@]+"${EXEC_ENV_ARGS[@]}"} "$PROFILE" "$@"
}

cmd_shell() {
  [[ -t 0 && -t 1 ]] || die "pis shell needs an interactive terminal"
  resolve_context
  auto_sync
  need_docker
  ensure_android_sdk
  ensure_kvm
  ensure_image "$PROFILE"
  ensure_container
  compose exec ${EXEC_ENV_ARGS[@]+"${EXEC_ENV_ARGS[@]}"} "$PROFILE" bash
}

cmd_logs() {
  resolve_context
  need_docker
  compose logs --tail=200 "$@" "$PROFILE"
}

cmd_status() {
  resolve_context
  printf 'repo:      %s\n' "$REPO_ROOT"
  printf 'profile:   %s (from %s)\n' "$PROFILE" "$PROFILE_SOURCE"
  printf 'project:   %s\n' "$COMPOSE_PROJECT_NAME"
  local have state
  have="$(docker image inspect "pi-sandbox:$PROFILE" --format '{{index .Config.Labels "org.pi-sandbox.dockerhash"}}' 2>/dev/null || true)"
  if [[ -z "$have" ]]; then
    state=missing
  elif [[ "$have" == "$DOCKER_HASH" ]]; then
    state=ok
  else
    state=stale
  fi
  printf 'image:     pi-sandbox:%s → %s\n' "$PROFILE" "$state"
  if [[ "${PI_SANDBOX_ALLOW_NO_AUTH:-0}" == 1 ]]; then
    printf 'auth:      ok (PI_SANDBOX_ALLOW_NO_AUTH=1 — keyless provider)\n'
  elif auth_missing; then
    printf 'auth:      MISSING (no provider credential vars in .env or host env)\n'
  else
    printf 'auth:      ok (%s)\n' "$(auth_display)"
  fi
  if [[ "$PROFILE" == android ]]; then
    if [[ -r /dev/kvm && -w /dev/kvm ]]; then
      printf 'kvm:       ok (/dev/kvm, gid %s)\n' "$KVM_GID"
    else
      printf 'kvm:       MISSING or not accessible\n'
    fi
    local sdk_root sdk_missing
    sdk_root="$(android_sdk_root)"
    sdk_missing="$(android_sdk_missing_csv "$sdk_root")"
    if [[ ! -d "$sdk_root" ]]; then
      printf 'sdk:       MISSING (expected at %s)\n' "$sdk_root"
    elif [[ -z "$sdk_missing" ]]; then
      printf 'sdk:       ok (%s)\n' "$sdk_root"
    else
      printf 'sdk:       INCOMPLETE at %s — missing: %s\n' "$sdk_root" "$sdk_missing"
    fi
  fi
  printf 'container:\n'
  compose ps 2>/dev/null || printf '  (docker unavailable)\n'
}

cmd_doctor() {
  resolve_context
  local smoke=0 fail=0
  for a in "$@"; do
    case "$a" in
      --smoke) smoke=1 ;;
      *) die "doctor: unknown option $a" ;;
    esac
  done
  ok() { printf '  ✓ %s\n' "$*"; }
  bad() {
    printf '  ✗ %s\n' "$*"
    fail=1
  }
  soft() { printf '  ! %s\n' "$*"; }

  if command -v docker >/dev/null 2>&1; then
    ok "docker CLI ($(docker --version 2>/dev/null | head -1))"
  else bad "docker CLI missing"; fi
  if docker info >/dev/null 2>&1; then
    ok "docker daemon reachable"
  else bad "docker daemon not reachable — start Docker and retry (pis never falls back to host pi)"; fi
  if docker compose version >/dev/null 2>&1; then
    ok "$(docker compose version --short 2>/dev/null | sed 's/^/docker compose v/')"
    if ! compose_version_ok; then
      bad "docker compose is older than 2.24 — the .env passthrough (env_file) needs >= 2.24; upgrade the compose plugin"
    fi
  else bad "docker compose v2 missing"; fi

  if [[ "${PI_SANDBOX_ALLOW_NO_AUTH:-0}" == 1 ]]; then
    soft "provider auth bypassed (PI_SANDBOX_ALLOW_NO_AUTH=1 — keyless provider)"
  elif auth_missing; then
    bad "no provider credentials configured — add your provider's key to $PI_SANDBOX_HOME/.env (see .env.example), export a *_API_KEY, or run ./install (seeds from ~/.pi/agent/auth.json); keyless providers: PI_SANDBOX_ALLOW_NO_AUTH=1"
  else
    ok "provider auth: $(auth_display)"
  fi

  if [[ -c /dev/kvm && -r /dev/kvm && -w /dev/kvm ]]; then
    ok "/dev/kvm accessible (gid $KVM_GID) — android emulator will use hardware acceleration"
  elif [[ -c /dev/kvm ]]; then
    soft "/dev/kvm exists but is not rw for $USER (android profile will refuse to start)"
  else
    soft "/dev/kvm not found — android emulator cannot run on this machine"
  fi

  if [[ "$PROFILE" == android ]]; then
    local sdk_root sdk_missing
    sdk_root="$(android_sdk_root)"
    sdk_missing="$(android_sdk_missing_csv "$sdk_root")"
    if [[ ! -d "$sdk_root" ]]; then
      bad "android SDK not found at $sdk_root — the android profile will refuse to start (set PI_SANDBOX_ANDROID_SDK=/path/to/Android/Sdk)"
    elif [[ -z "$sdk_missing" ]]; then
      ok "android SDK complete ($sdk_root, mounted read-only at /opt/android-sdk)"
    else
      bad "android SDK at $sdk_root is incomplete — missing: $sdk_missing"
    fi
  fi

  if [[ -f "$PI_SANDBOX_HOME/pi-home/settings.json" ]]; then
    ok "pi-home/settings.json present"
  else
    soft "pi-home/settings.json missing — run: pis sync-config"
  fi

  local hostpi
  hostpi="$(host_pi_version)"
  if [[ -z "$hostpi" ]]; then
    soft "host pi not on PATH — sandboxes keep their pinned pi $PI_VERSION (fine if pi runs only inside)"
  elif [[ "$hostpi" == "$PI_VERSION" ]]; then
    ok "pi version in sync (host and sandbox: $PI_VERSION)"
  else
    soft "pi version drift: host pi $hostpi, sandbox pinned to $PI_VERSION — run 'pis use-pi' to sync and rebuild (README: Updating pi)"
  fi

  local p have
  for p in general web android; do
    have="$(docker image inspect "pi-sandbox:$p" --format '{{index .Config.Labels "org.pi-sandbox.dockerhash"}}' 2>/dev/null || true)"
    if [[ -z "$have" ]]; then
      soft "image pi-sandbox:$p not built yet (auto-builds on first use)"
    elif [[ "$have" == "$DOCKER_HASH" ]]; then
      ok "image pi-sandbox:$p up to date"
    else
      soft "image pi-sandbox:$p is stale (auto-rebuilds on next use, or: pis rebuild $p)"
    fi
  done

  if [[ $smoke == 1 ]]; then
    printf 'smoke test: running pi inside the %s sandbox…\n' "$PROFILE"
    require_auth
    ensure_android_sdk
    ensure_kvm
    ensure_image "$PROFILE"
    ensure_container
    local out
    out="$(compose exec -T ${EXEC_ENV_ARGS[@]+"${EXEC_ENV_ARGS[@]}"} "$PROFILE" bash -lc "$WRAPPER_PLAIN" pis-sh -p 'Reply with exactly: OK' 2>&1)" ||
      {
        printf '%s\n' "$out" >&2
        bad "smoke test: pi failed to run"
      }
    if [[ "${out:-}" == *OK* ]]; then
      ok "smoke test: pi answered inside the sandbox"
    else bad "smoke test: unexpected answer: ${out:-<empty>}"; fi
  fi

  if [[ $fail == 1 ]]; then
    printf '\ndoctor: some checks FAILED\n' >&2
    return 1
  fi
  printf '\ndoctor: all checks passed\n'
}

cmd_rebuild() {
  resolve_context
  need_docker
  local targets=() t
  for a in "$@"; do
    case "$a" in
      general | web | android) targets+=("$a") ;;
      all) targets+=(general web android) ;;
      *) die "rebuild: unknown target '$a' (expected: general | web | android | all)" ;;
    esac
  done
  if [[ ${#targets[@]} -eq 0 ]]; then targets=("$PROFILE"); fi
  # Layering: general must build before web/android derive from it.
  local ordered=()
  for t in general web android; do
    if [[ " ${targets[*]} " == *" $t "* ]]; then ordered+=("$t"); fi
  done
  for t in "${ordered[@]}"; do
    note "building pi-sandbox:$t…"
    compose build "$t" || die "building pi-sandbox:$t failed"
  done
  note "build complete"
}

# Pin the sandbox pi version and rebuild — the one command that ends version
# drift (README: Updating pi). Bare `pis use-pi` adopts the host pi's version.
cmd_use_pi() {
  [[ $# -le 1 ]] || die "usage: pis use-pi [x.y.z]" "bare 'pis use-pi' adopts the host pi version"
  local v="${1:-}" cfg="$CONFIG_FILE"
  if [[ -z "$v" ]]; then
    v="$(host_pi_version)"
    [[ -n "$v" ]] ||
      die "host pi not found on PATH — pass an explicit version" "usage: pis use-pi x.y.z (e.g. pis use-pi 1.4.0)"
  fi
  [[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.+-]+)?$ ]] ||
    die "not a pi version: '$v'" "usage: pis use-pi x.y.z (e.g. pis use-pi 1.4.0)"
  mkdir -p "$(dirname "$cfg")"
  if [[ -f "$cfg" ]] && grep -q '^PI_VERSION=' "$cfg"; then
    sed -i "s/^PI_VERSION=.*/PI_VERSION=$v/" "$cfg"
  else
    printf 'PI_VERSION=%s\n' "$v" >>"$cfg"
  fi
  PI_VERSION="$v"
  DOCKER_HASH="$(compute_docker_hash)"
  note "sandbox pi pinned to $v (saved in $cfg)"
  cmd_rebuild all
  note "images rebuilt with pi $v — next 'pis' run uses it"
}

cmd_down() {
  resolve_context
  need_docker
  compose down
  note "sandbox stopped (volumes kept — sessions survive)"
}

cmd_clean() {
  local yes=0
  for a in "$@"; do
    case "$a" in
      -y | --yes) yes=1 ;;
      *) die "clean: unknown option $a (destructive — requires -y)" ;;
    esac
  done
  [[ $yes == 1 ]] || die "clean deletes this sandbox's volumes, including pi sessions" "re-run as: pis clean -y"
  resolve_context
  need_docker
  compose down -v --remove-orphans
  note "sandbox and volumes deleted (pi-home/ overlay untouched)"
}

# Physical devices stay on the host: there is deliberately no adb bridge into
# sandboxes (one would give sandbox code full control of every device the host
# can see). Build in the sandbox — output lands in the shared /workspace — then
# install from the host with this helper (README: Physical devices).
cmd_install_apk() {
  local apk=""
  if [[ $# -gt 0 && (-f "$1" || "$1" == *.apk) ]]; then
    apk="$1"
    shift
  fi
  resolve_context
  local adb
  adb="$(android_sdk_root)/platform-tools/adb"
  if [[ ! -x "$adb" ]]; then
    adb="$(command -v adb || true)"
    [[ -n "$adb" ]] ||
      die "adb not found — cannot install to a physical device" \
        "install Android platform-tools (…/platform-tools/adb under PI_SANDBOX_ANDROID_SDK), or put adb on PATH"
  fi
  if [[ -z "$apk" ]]; then
    apk="$(find "$REPO_ROOT" -type f -name '*.apk' -path '*/build/outputs/*' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)"
    [[ -n "$apk" ]] ||
      die "no APK found under $REPO_ROOT/**/build/outputs" \
        "build one first (e.g. pis run -- ./gradlew assembleDebug), or pass a path: pis install-apk /path/to/app.apk"
  fi
  [[ -f "$apk" ]] || die "APK not found: $apk" "pass an existing .apk file"
  note "installing $apk (adb: $adb)"
  "$adb" install -r "$apk" "$@" ||
    die "adb install failed" \
      "check 'adb devices' — the device must be visible to the HOST adb (there is no adb bridge into sandboxes; README: Physical devices)"
}

# ------------------------------------------------------------- config sync -- #
# pi-home/ is a GENERATED mirror of the host pi agent dir (~/.pi/agent) plus
# documented sandbox deltas (see pi-home/README.md). `pis` refreshes it
# automatically before every pi/run/shell invocation — you never need to
# remember to sync after changing settings or adding extensions on the host.
# Disable auto-sync with PI_SANDBOX_NO_SYNC=1; force it anytime with
# `pis sync-config`.
#
# Deltas applied to the mirror:
#   - packages: "npm:pi-sbx" removed (prompt-heavy, redundant inside the boundary)
#   - defaultProjectTrust: "always" (unattended runs must not stall)
#   - sandbox.json (pi-sbx policy) and host symlinks are not mirrored
#   - curated exception: pi-home/AGENTS.md is never touched by auto-sync

sync_source_stamp() {
  local src="${PI_AGENT_DIR:-$HOME/.pi/agent}"
  [[ -d "$src" ]] || {
    echo "no-source"
    return 0
  }
  (cd "$src" && find . -maxdepth 3 \
    \( -path './sessions' -o -path './reviews' -o -path './install' -o -path './bin' \
    -o -path './npm/node_modules' -o -name 'auth.json' -o -name 'models-store.json' \) -prune \
    -o \( -type f -printf 'f %p %T@ %s\n' -o -type l -printf 'l %p %l\n' \) \
    2>/dev/null | LC_ALL=C sort | sha256sum | cut -d' ' -f1)
}

SYNC_CHANGED=()

do_sync() {
  local quiet=$1 with_agents=$2 keep_pi_sbx=$3 no_npm=$4
  local src="${PI_AGENT_DIR:-$HOME/.pi/agent}" dst="$PI_SANDBOX_HOME/pi-home"
  [[ -d "$src" ]] || die "host agent directory not found: $src"
  mkdir -p "$dst"
  SYNC_CHANGED=()
  local tmp out f d

  # settings.json — the host file is the source of truth, plus sandbox deltas.
  if [[ -f "$src/settings.json" ]]; then
    local keep_json=false
    if [[ $keep_pi_sbx == 1 ]]; then keep_json=true; fi
    tmp="$(mktemp)"
    jq --argjson keep "$keep_json" '
      (if $keep then .
       elif .packages then (.packages |= map(select(. != "npm:pi-sbx")))
       else . end)
      | .defaultProjectTrust = "always"
    ' "$src/settings.json" >"$tmp"
    if [[ ! -f "$dst/settings.json" ]] || ! cmp -s "$tmp" "$dst/settings.json"; then
      mv "$tmp" "$dst/settings.json"
      SYNC_CHANGED+=("settings.json")
    else
      rm -f "$tmp"
    fi
  elif [[ $quiet == 0 ]]; then
    warn "no $src/settings.json — keeping existing pi-home/settings.json"
  fi

  # Optional top-level config files — mirrored both ways (host removal removes).
  for f in keybindings.json mcp.json models.json SYSTEM.md APPEND_SYSTEM.md; do
    if [[ -f "$src/$f" ]]; then
      if [[ ! -f "$dst/$f" ]] || ! cmp -s "$src/$f" "$dst/$f"; then
        cp -f "$src/$f" "$dst/$f"
        SYNC_CHANGED+=("$f")
      fi
    elif [[ -f "$dst/$f" ]]; then
      rm -f "$dst/$f"
      SYNC_CHANGED+=("$f (removed)")
    fi
  done

  # Resource dirs — mirrored with --delete so host removals propagate there too.
  # Host symlinks are skipped: they would dangle inside containers.
  local excludes=() link link_name f_name
  for d in extensions skills prompts themes; do
    [[ -d "$src/$d" ]] || continue
    excludes=()
    while IFS= read -r -d '' link; do
      link_name="$(basename "$link")"
      # Patterns are anchored at the rsync root, which is the dir itself.
      excludes+=("--exclude=/$link_name")
      if [[ $quiet == 0 ]]; then
        warn "skipped $d/$link_name (symlink to $(readlink -f "$link" 2>/dev/null || echo unresolvable)) — copy it into pi-home/$d manually if a sandbox needs it"
      fi
      # Drop any previously mirrored copy of this symlink.
      rm -f "$dst/$d/$link_name"
    done < <(find "$src/$d" -maxdepth 1 -type l -print0 2>/dev/null)
    if [[ $d == extensions ]]; then
      # Extensions pi cannot load brick startup for the whole sandbox — skip
      # them at the source, loudly, instead of letting them through.
      for f in "$src/$d"/*.ts "$src/$d"/*.tsx "$src/$d"/*.js "$src/$d"/*.jsx "$src/$d"/*.mjs "$src/$d"/*.cjs; do
        [[ -f "$f" && ! -L "$f" ]] || continue
        if [[ ! -s "$f" ]] || ! grep -q 'export' "$f"; then
          f_name="$(basename "$f")"
          excludes+=("--exclude=/$f_name")
          rm -f "$dst/$d/$f_name"
          warn "skipped extensions/$f_name (empty or no exports — pi cannot load it); fix or remove $f"
        fi
      done
    fi
    mkdir -p "$dst/$d"
    out="$(rsync -ai --delete "${excludes[@]}" --exclude '/sandbox.json' --exclude '/.gitkeep' "$src/$d/" "$dst/$d/")" ||
      die "rsync failed for $src/$d"
    if [[ -n "$out" ]]; then SYNC_CHANGED+=("$d/"); fi
  done

  # npm/ pre-warm (mirrored; package.json written separately, minus pi-sbx).
  if [[ $no_npm == 0 && -d "$src/npm" ]]; then
    out="$(rsync -ai --delete --exclude '/package.json' "$src/npm/" "$dst/npm/")" ||
      die "rsync failed for $src/npm"
    if [[ -n "$out" ]]; then SYNC_CHANGED+=("npm/"); fi
    if [[ -f "$src/npm/package.json" ]]; then
      tmp="$(mktemp)"
      if [[ $keep_pi_sbx == 1 ]]; then
        cp "$src/npm/package.json" "$tmp"
      else
        jq 'del(.dependencies["pi-sbx"], .devDependencies["pi-sbx"])' "$src/npm/package.json" >"$tmp"
      fi
      if [[ ! -f "$dst/npm/package.json" ]] || ! cmp -s "$tmp" "$dst/npm/package.json"; then
        mv "$tmp" "$dst/npm/package.json"
        SYNC_CHANGED+=("npm/package.json")
      else
        rm -f "$tmp"
      fi
    fi
  fi

  # AGENTS.md is user-curated — only replaced on explicit request.
  if [[ $with_agents == 1 ]]; then
    if [[ -f "$src/AGENTS.override.md" ]]; then
      cp -f "$src/AGENTS.override.md" "$dst/AGENTS.md"
      SYNC_CHANGED+=("AGENTS.md")
    elif [[ -f "$src/AGENTS.md" ]]; then
      cp -f "$src/AGENTS.md" "$dst/AGENTS.md"
      SYNC_CHANGED+=("AGENTS.md")
    elif [[ $quiet == 0 ]]; then
      warn "host has no AGENTS.md — keeping the curated pi-home/AGENTS.md"
    fi
  fi

  # Invariant: no credentials in the overlay, ever.
  [[ ! -e "$dst/auth.json" ]] || die "refusing to continue: $dst/auth.json must never exist" \
    "auth inside sandboxes is env-var passthrough only (docs/security.md)"
}

auto_sync() {
  if [[ "${PI_SANDBOX_NO_SYNC:-0}" == 1 ]]; then return 0; fi
  local src="${PI_AGENT_DIR:-$HOME/.pi/agent}"
  [[ -d "$src" ]] || return 0
  local stamp
  stamp="$(sync_source_stamp)"
  if [[ -f "$PI_SANDBOX_HOME/pi-home/.sync-stamp" ]] &&
    [[ "$(<"$PI_SANDBOX_HOME/pi-home/.sync-stamp")" == "$stamp" ]]; then
    return 0
  fi
  do_sync 1 0 0 0
  printf '%s' "$stamp" >"$PI_SANDBOX_HOME/pi-home/.sync-stamp"
  if [[ ${#SYNC_CHANGED[@]} -gt 0 ]]; then
    note "pi config synced from host: ${SYNC_CHANGED[*]}"
  fi
}

cmd_sync_config() {
  local with_agents=0 keep_pi_sbx=0 no_npm=0
  for a in "$@"; do
    case "$a" in
      --with-agents) with_agents=1 ;;
      --keep-pi-sbx) keep_pi_sbx=1 ;;
      --no-npm) no_npm=1 ;;
      *) die "sync-config: unknown option $a" ;;
    esac
  done
  do_sync 0 "$with_agents" "$keep_pi_sbx" "$no_npm"
  printf '%s' "$(sync_source_stamp)" >"$PI_SANDBOX_HOME/pi-home/.sync-stamp"
  note "sync complete → $PI_SANDBOX_HOME/pi-home (changed: ${SYNC_CHANGED[*]:-none})"
}

cmd_host() {
  local host_pi
  host_pi="$(command -v pi || true)"
  [[ -n "$host_pi" ]] || die "host pi not found on PATH"
  printf '⚠ UNSANDBOXED: running host pi (%s) — no boundary, host credentials and files\n' "$host_pi" >&2
  exec pi "$@"
}

# -------------------------------------------------------------------- main -- #
main() {
  case "${1:-}" in
    "") cmd_pi "$@" ;;
    --)
      shift
      cmd_pi "$@"
      ;;
    --host)
      shift
      cmd_host "$@"
      ;;
    run)
      shift
      cmd_run "$@"
      ;;
    shell)
      shift
      cmd_shell "$@"
      ;;
    logs)
      shift
      cmd_logs "$@"
      ;;
    status)
      shift
      cmd_status "$@"
      ;;
    doctor)
      shift
      cmd_doctor "$@"
      ;;
    rebuild)
      shift
      cmd_rebuild "$@"
      ;;
    use-pi)
      shift
      cmd_use_pi "$@"
      ;;
    down)
      shift
      cmd_down "$@"
      ;;
    clean)
      shift
      cmd_clean "$@"
      ;;
    install-apk)
      shift
      cmd_install_apk "$@"
      ;;
    sync-config)
      shift
      cmd_sync_config "$@"
      ;;
    help | -h | --help) usage ;;
    --version) printf 'pis %s\n' "$PIS_VERSION" ;;
    *) cmd_pi "$@" ;;
  esac
}

main "$@"
